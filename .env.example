# Copy to .env and fill in, or set these as real environment variables.
# This project reads them from the environment directly (via os.environ),
# it does not load .env automatically -- this file is just a reference
# for which values you need.

MAILCHIMP_API_KEY=your-key-here-us21
MAILCHIMP_SERVER=us21
MAILCHIMP_LIST_ID=your-audience-id
